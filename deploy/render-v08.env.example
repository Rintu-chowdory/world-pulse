# Render API service — keep every value in Render secret environment variables
ENABLE_LIVE_INGESTION=true
INGESTION_INTERVAL_SECONDS=60
ENABLE_AI_ENRICHMENT=true
AI_WORKERS=2

# NASA FIRMS
FIRMS_MAP_KEY=replace_with_firms_map_key
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_DAY_RANGE=1

# OpenAI-compatible provider; never expose these to Cloudflare/browser
OPENAI_API_KEY=replace_with_server_side_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Managed Postgres/PostGIS
DATABASE_URL=postgresql://user:password@host:5432/worldpulse
DB_POOL_MAX=10

# Managed Redis; use a rediss:// URL when TLS is required
REDIS_URL=redis://:password@host:6379/0

# Public Cloudflare origin(s)
ALLOWED_ORIGINS=https://your-cloudflare-domain.example

# Frontend Cloudflare Pages environment variable
# NEXT_PUBLIC_API_BASE=https://your-render-api.example.com
